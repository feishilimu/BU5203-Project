# Copy this file to ".env" and fill it in.
# NEVER share or commit .env - it holds your private keys (.gitignore already excludes it).

# ---- Which AI to use: gemini | bedrock | offline -------------------------------
# Leave blank to auto-pick: Gemini if a key is set, else Bedrock, else offline.
LLM_PROVIDER=

# ---- Option 1: Google Gemini (free key: https://aistudio.google.com/apikey) ----
# Free-tier prompts may be used by Google to improve its products, so only ever
# send PUBLIC documents through it (which is all this tool does).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

# ---- Option 2: Amazon Bedrock (once your AWS account is verified) --------------
# AWS console > Bedrock > API keys. Model ID from Bedrock > Model catalog.
AWS_BEARER_TOKEN_BEDROCK=
AWS_REGION=us-east-1
BEDROCK_MODEL=

# ---- Responsible scraping --------------------------------------------------------
# Sent in our User-Agent so a website owner could contact us. Use a real address.
CONTACT_EMAIL=
